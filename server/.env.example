# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored so your credentials never get committed.

# --- Email (used to send sign-in codes, and the legacy startup code) ---
# The account that SENDS the codes. Gmail needs an App Password:
#   Google Account > Security > 2-Step Verification > App Passwords.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Sign-in (per-user email codes + session tokens; see auth.py) ---
# Who may sign in. Comma-separated allowlist of emails. If empty, EMAIL_RECEIVER
# is used; if that's empty too, ANY email may sign in (dev only — insecure!).
AUTH_ALLOWED_EMAILS=
# How long a signed-in session lasts before a refresh is needed (days).
AUTH_SESSION_TTL_DAYS=7
# How long the refresh token stays valid — the max time between sign-ins (days).
AUTH_REFRESH_TTL_DAYS=30
# One-time code lifetime (minutes) and max wrong tries before it's invalidated.
AUTH_CODE_TTL_MIN=10
AUTH_CODE_MAX_ATTEMPTS=5
# Where the auth DB lives (users, codes, tokens). Git-ignored.
# AUTH_DB=auth.db
# Print the sign-in code to the server console / return it to the client, for
# LOCAL testing when email isn't set up. NEVER enable in a real deployment.
AUTH_DEBUG_CODE=0
# Keep the legacy single shared code (the connect URL) working alongside email
# sign-in. Set to 0 to require email sign-in for everyone.
AUTH_LEGACY_CODE=1

# --- WebSocket server ---
# 0.0.0.0 listens on all interfaces, including your Tailscale IP.
HOST_IP=0.0.0.0
PORT=8765
# Static web UI port used by start.py.
WEB_PORT=8080

# Optional: a FIXED auth code you choose. Set this so you can connect from far
# away (cellular) where you can't see the Mac's screen or scan the QR. If left
# unset, a new random code is generated each time the server starts.
# Over Tailscale only your own devices can reach the server, so a fixed personal
# code is a reasonable trade-off — just keep it private.
# AUTH_CODE=123456

# --- Conductor control ---
# Reading projects/chats/messages needs NO token (it reads the local DB).
# SENDING messages to a chat needs a Conductor API token. Get one from the
# Conductor app / your account, then paste it here (or run: conductor auth login).
CONDUCTOR_API_TOKEN=

# Free sending starts a NEW task via a conductor:// deep link, which pre-fills
# the prompt. To actually send it (fire-and-forget), the server presses Enter
# for you — this needs Accessibility permission for the app running the server.
CONDUCTOR_AUTOSUBMIT=1
# Seconds to wait for the new workspace/composer before pressing send.
CONDUCTOR_SUBMIT_DELAY=4
# "enter" (default) or "cmd-enter" if your Conductor sends on Command-Enter.
CONDUCTOR_SUBMIT_KEY=enter

# If Conductor is CLOSED when the phone acts, the server launches it. On such a
# cold launch it also enters macOS full screen so the sidebar layout is stable
# for the OCR navigation. Set to 0 to launch it normally (no full screen).
# (If Conductor is already open, its windows are left untouched either way.)
CONDUCTOR_LAUNCH_FULLSCREEN=1
# Seconds to wait for Conductor's window after a cold launch.
CONDUCTOR_LAUNCH_TIMEOUT=12

# Picking an AI model for a new task: the conductor:// deep link can't carry a
# model, so the server sets it by clicking the composer's model selector. That
# control is an icon OCR can't find, so give its on-screen position as "x,y"
# fractions (run: python3 conductor_ui.py where, hover the model selector).
# Leave empty to skip model-setting — new tasks then use the workspace default.
CONDUCTOR_MODEL_PICKER_XY=

# Max wrong auth-code attempts before a client is kicked.
MAX_AUTH_ATTEMPTS=5

# Path to the button-coordinate map (see coordinates.example.json).
COORDINATES_FILE=coordinates.json
